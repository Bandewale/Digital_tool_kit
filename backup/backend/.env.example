# =============================================
# AgriReadiness Backend – Environment Variables
# =============================================
# Copy this file and rename it to: .env
# Fill in your actual values below
# NEVER commit .env to GitHub!
# =============================================

# Your Anthropic API Key (get it from https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Port for the backend server (default is 3000)
# Render.com sets this automatically – no need to change
PORT=3000
